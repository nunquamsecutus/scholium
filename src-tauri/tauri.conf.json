{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Edu Harness",
  "version": "0.1.0",
  "identifier": "com.brent.edu-harness",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Edu Harness",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "cli": {
      "description": "Edu Harness — interactive educational book generator",
      "args": [
        {
          "name": "api-key",
          "short": "k",
          "takesValue": true,
          "description": "Anthropic Claude API key (implies --provider claude)"
        },
        {
          "name": "provider",
          "short": "p",
          "takesValue": true,
          "description": "LLM provider to use: claude or ollama (default: ollama)"
        },
        {
          "name": "ollama-url",
          "takesValue": true,
          "description": "Ollama server base URL (default: http://localhost:11434)"
        },
        {
          "name": "ollama-model",
          "takesValue": true,
          "description": "Ollama model name (default: llama3.2)"
        }
      ]
    }
  }
}
